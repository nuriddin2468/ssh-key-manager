{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Key Manager",
  "version": "0.11.0",
  "identifier": "dev.sshkeymanager.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SSH Key Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#0A0D14",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 20 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421 http://localhost:1420",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Manage SSH keys, hosts and ssh-agent",
    "longDescription": "A desktop front-end for OpenSSH: keys in ~/.ssh, ~/.ssh/config, known_hosts and ssh-agent, with a security audit. Everything stays compatible with ssh, git and your IDE.",
    "copyright": "© 2026 SSH Key Manager contributors",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": { "depends": ["openssh-client"] },
      "rpm": { "depends": ["openssh-clients"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBNkM4MUM3NzQxOTE2QkYKUldTL0ZobDB4NEZzaWdCYzdWMXByRkErRW1PMjUxbkEzR2tsMVNLNG5qS3JVZHMzMTc3NkpGaWkK",
      "endpoints": [
        "https://github.com/nuriddin2468/ssh-key-manager/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
